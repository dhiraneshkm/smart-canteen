# Example Application Properties
# Copy this file to application-local.properties and update the credentials

server.port=8080

spring.datasource.url=jdbc:mysql://localhost:3306/smart_canteen_db?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
spring.datasource.driver-class-name=com.mysql.cj.jdbc.Driver
spring.datasource.username=root
spring.datasource.password=your_secure_password_here

spring.jpa.hibernate.ddl-auto=none
spring.flyway.enabled=true

app.jwt.secret=your_super_secret_256_bit_jwt_key_here_must_be_long_enough
app.jwt.expiration-ms=86400000
